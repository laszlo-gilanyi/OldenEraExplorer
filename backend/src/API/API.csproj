<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>API</RootNamespace>
    <AssemblyName>OldenEraExplorer</AssemblyName>
    <!-- Assembly metadata for Task Manager / Activity Monitor -->
    <Title>Olden Era Explorer</Title>
    <Product>Olden Era Explorer</Product>
    <AssemblyTitle>Olden Era Explorer</AssemblyTitle>
    <!-- Single-file, self-contained publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Hide console window on Windows, keep it on Linux/macOS for debugging -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="!$(RuntimeIdentifier.StartsWith('win')) AND '$(RuntimeIdentifier)' != ''">Exe</OutputType>
    <!-- Disable web.config generation (not needed for self-contained desktop app) -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Disable StaticWebAssets in dev mode (frontend served by Vite) -->
    <StaticWebAssetsEnabled Condition="'$(Configuration)' == 'Debug'">false</StaticWebAssetsEnabled>
    <!-- Set executable icon (Windows only - works on any OS during build, only applies when targeting Windows) -->
    <ApplicationIcon>..\..\..\frontend\public\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release version scoped to this project so it doesn't override transitive
       sub-project versions (which would mismatch deps.json vs DLL metadata in
       the single-file bundle). -->
  <PropertyGroup Condition="'$(AppReleaseVersion)' != ''">
    <Version>$(AppReleaseVersion)</Version>
    <AssemblyVersion>$(AppAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(AppAssemblyVersion)</FileVersion>
    <InformationalVersion>$(AppReleaseVersion)</InformationalVersion>
  </PropertyGroup>

  <!-- Build frontend and copy to wwwroot (Release only) -->
  <Target Name="BuildFrontend" BeforeTargets="ResolveAssemblyReferences" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <FrontendDir>$(MSBuildThisFileDirectory)..\..\..\frontend</FrontendDir>
      <WwwrootDir>$(MSBuildThisFileDirectory)wwwroot</WwwrootDir>
    </PropertyGroup>
    <Exec Command="npm install" WorkingDirectory="$(FrontendDir)" Condition="!Exists('$(FrontendDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" />
    <RemoveDir Directories="$(WwwrootDir)" />
    <ItemGroup>
      <FrontendFiles Include="$(FrontendDir)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(WwwrootDir)\%(RecursiveDir)" />
    <ItemGroup>
      <EmbeddedResource Include="$(WwwrootDir)\**\*" LinkBase="wwwroot" />
    </ItemGroup>
    <Message Importance="high" Text="Frontend built and embedded" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.1" />
    <PackageReference Include="NotificationIcon.NET" Version="1.2.8" />
  </ItemGroup>


  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Localization/Localization.csproj" />
    <ProjectReference Include="../GameData/GameData.csproj" />
    <ProjectReference Include="../AssetExtractor/AssetExtractor.csproj" />
  </ItemGroup>

  <!-- Custom unit stat icons (drawn by user, not from Unity assets) -->
  <!-- Embed as resources directly into the executable -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\assets\CustomIcons\*.png">
      <LogicalName>CustomAssets/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed tray icons (Release only - dev mode uses terminal) -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\frontend\public\icon.ico" LogicalName="icon.ico" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\frontend\public\icon.png" LogicalName="icon.png" />
  </ItemGroup>

  <!-- Copy native tray icon library for each platform -->
  <Target Name="CopyTrayIconNativeLib" AfterTargets="Publish">
    <!-- Windows native DLL -->
    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
      <TrayNativeLib>$(NuGetPackageRoot)notificationicon.net/1.2.8/runtimes/win-x64/native/notification_icon.dll</TrayNativeLib>
    </PropertyGroup>
    <!-- Linux native SO -->
    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
      <TrayNativeLib>$(NuGetPackageRoot)notificationicon.net/1.2.8/runtimes/linux-x64/native/libnotification_icon.so</TrayNativeLib>
    </PropertyGroup>
    <Copy SourceFiles="$(TrayNativeLib)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(TrayNativeLib)')" />
    <Message Importance="high" Text="Copied tray icon native library: $(TrayNativeLib)" Condition="Exists('$(TrayNativeLib)')" />
  </Target>

</Project>
